      "id": "recaptcha",
      "name": "Google reCAPTCHA",
      "source": "reCAPTCHA documentation (markers); is-antibot (MIT) for the block-page rules",
      "signals": [
        {
          "type": "body",
          "name": "captcha-form",
          "pattern": "^(?=[\\s\\S]*\\sid=[\"']captcha-form[\"'])(?=[\\s\\S]*g-recaptcha)",
          "statuses": [
            403,
            429
          ],
          "strength": "challenge",
          "sources": [
            "https://github.com/microlinkhq/is-antibot/blob/HEAD/src/providers.json"
          ],
          "note": "is-antibot matches this on any status; scrapescope restricts it to 403 and 429 (Google's /sorry/ page is a 429), because an ordinary 200 contact or login form can carry id=\"captcha-form\" and a g-recaptcha widget"
        },
        {
          "type": "body",
          "name": "block-page",
          "pattern": "g-recaptcha|\\b(?:window\\.)?grecaptcha\\s*\\.(?:execute|render|ready|getResponse|enterprise)\\b",
          "statuses": [
            403,
            429
          ],
          "strength": "challenge",
          "sources": [
            "https://github.com/microlinkhq/is-antibot/blob/HEAD/src/providers.json",
            "https://developers.google.com/recaptcha/docs/display"
          ],
          "note": "is-antibot uses statuses 403, 429 and 503; scrapescope leaves out 503, because maintenance pages also load CAPTCHA widgets"
        },
        {
          "type": "body",
          "name": "api-js",
          "pattern": "www\\.google\\.com/recaptcha/api\\.js",
          "statuses": [],
          "strength": "vendor",
          "sources": [
            "https://developers.google.com/recaptcha/docs/display"
          ]
        },
        {
          "type": "body",
          "name": "widget",
          "pattern": "class=[\"'][^\"']*\\bg-recaptcha\\b",
          "statuses": [],
          "strength": "vendor",
          "sources": [
            "https://developers.google.com/recaptcha/docs/display"
          ]
        }
      ],
      "docs": [
        "https://developers.google.com/recaptcha/docs/display"
      ]
    },
