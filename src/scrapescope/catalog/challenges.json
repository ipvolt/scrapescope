          "type": "cookie",
          "name": "__cf_bm",
          "pattern": null,
          "statuses": [],
          "strength": "vendor",
          "sources": [
            "https://developers.cloudflare.com/fundamentals/reference/policies-compliances/cloudflare-cookies/"
          ]
        },
        {
          "type": "cookie",
          "name": "cf_clearance",
          "pattern": null,
          "statuses": [],
          "strength": "vendor",
          "sources": [
            "https://developers.cloudflare.com/fundamentals/reference/policies-compliances/cloudflare-cookies/",
