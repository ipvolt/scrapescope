{
  "version": "2026.09.23",
  "attribution": "Some vendor signals are adapted from is-antibot (https://github.com/microlinkhq/is-antibot), MIT License, Copyright \u00a9 2025 Microlink <hello@microlink.io> (https://microlink.io). The full copyright and permission notice is in the NOTICE file shipped with scrapescope. Each signal lists its own sources: is-antibot's providers.json for the signals it has, vendor documentation pages for the rest.",
  "notes": "Classification only: scrapescope uses these signals to say that a response is a challenge or block page, never to get past one. strength 'challenge' marks the response blocked; strength 'vendor' only names the vendor. Every signal cites sources that contain it (is-antibot or a vendor documentation page); a signal without one is not listed. Markers that also appear on ordinary pages (bot-management cookies, sensor scripts, CAPTCHA widgets, pages that mention a vendor) are vendor strength or restricted by statuses, and neither a 503 with a CAPTCHA widget nor a 503 with only a bot-management cookie or header is called a challenge (maintenance pages behind these vendors carry them too). The verify-page rules need a challenge status, because an ordinary 200 form can label its CAPTCHA widget 'Verify you are human'. Semantics: docs/dev/contracts.md section 8.",
  "vendors": [
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "source": "Cloudflare documentation; _cf_chl_opt and cf_clearance also in is-antibot (MIT)",
      "signals": [
        {
          "type": "header",
          "name": "cf-mitigated",
          "pattern": "^challenge$",
          "statuses": [],
          "strength": "challenge",
          "sources": [
            "https://developers.cloudflare.com/cloudflare-challenges/challenge-types/challenge-pages/detect-response/",
            "https://github.com/microlinkhq/is-antibot/blob/HEAD/src/providers.json"
          ]
        },
        {
          "type": "body",
          "name": "challenge-options",
          "pattern": "_cf_chl_opt",
          "statuses": [
            403,
            429,
            503
          ],
          "strength": "challenge",
          "sources": [
            "https://github.com/microlinkhq/is-antibot/blob/HEAD/src/providers.json"
          ],
          "note": "is-antibot matches this on any status; scrapescope adds the status restriction"
        },
        {
          "type": "body",
          "name": "error-1xxx",
          "pattern": "^(?=[\\s\\S]*Access denied)(?=[\\s\\S]*\\bError\\s*(?:<[^>]{0,120}>\\s*){0,4}10[0-9]{2}\\b)",
          "statuses": [
            403
          ],
          "strength": "challenge",
          "sources": [
            "https://developers.cloudflare.com/support/troubleshooting/http-status-codes/cloudflare-1xxx-errors/error-1020/",
            "https://developers.cloudflare.com/support/troubleshooting/http-status-codes/cloudflare-1xxx-errors/"
          ],
          "note": "Cloudflare's own 1xxx 'Access denied' block pages (for example Error 1020, a firewall rule) are 403 responses; the rule needs both the 'Access denied' text and an 'Error 10xx' code (markup between 'Error' and the code is allowed) and fires only on 403"
        },
        {
          "type": "body",
          "name": "challenge-platform",
          "pattern": "/cdn-cgi/challenge-platform/",
          "statuses": [],
          "strength": "vendor",
          "sources": [
            "https://developers.cloudflare.com/cloudflare-challenges/challenge-types/javascript-detections/"
          ]
        },
        {
          "type": "header",
          "name": "cf-ray",
          "pattern": null,
          "statuses": [],
          "strength": "vendor",
          "sources": [
            "https://developers.cloudflare.com/fundamentals/reference/http-headers/"
          ]
